import("//build/config/features.gni")
import("//wings8os/extensions/common/api/wings8os_schema.gni")
import("//extensions/buildflags/buildflags.gni")
import("//tools/json_schema_compiler/json_schema_api.gni")
import("//tools/json_schema_compiler/json_features.gni")
import("//wings8os/build/config/buildflags.gni")


assert(enable_extensions)

generated_json_strings("wings8os_api") {
  sources = extensions_api_schema_files
  bundle_name = "Wings8OS"
  root_namespace = extensions_api_root_namespace
  schema_include_rules = extensions_api_schema_include_rules
  deps = [
      "//chromeos",
  ]
  visibility = [ ":api" ]
}

generated_types("wings8os_api_types") {
  sources = extensions_api_schema_files
  root_namespace = extensions_api_root_namespace
  deps = [
    "//base",
    "//extensions/buildflags",
    "//chromeos",
  ]
  visibility = [ ":api" ]
}

group("api"){
  deps = [
    ":wings8os_api",
    ":wings8os_api_types",
  ]
}

group("wings8os_features") {
  public_deps = [
    ":api_features",
    ":permission_features",
  ]
}

json_features("api_features") {
  feature_type = "APIFeature"
  method_name = "AddWings8OSAPIFeatures"
  sources = [
    "_api_features.json",
  ]
  if (use_wings8os_license) {
    sources += [
      "_license_api_features.json",
    ]
  }
  visibility = [ ":wings8os_features" ]
}

json_features("permission_features") {
  feature_type = "PermissionFeature"
  method_name = "AddWings8OSPermissionFeatures"
  sources = [
    "_permission_features.json",
  ]
  visibility = [ ":wings8os_features" ]
}
