<?xml version="1.0" encoding="utf-8"?>
<!-- extend chrome/app/generated_resources.grd -->
<grit-part>

  <if expr="not openwings8">
    <message name="IDS_EXTENSION_PROMPT_WARNING_WINGS8OS_PRIVATE_API" desc="Permission string for implementing Wings8OS Private Api">
      Interface and communicate with Wings8OS core services and processes.
    </message>
  </if>
  <if expr="openwings8">
    <message name="IDS_EXTENSION_PROMPT_WARNING_WINGS8OS_PRIVATE_API" desc="Permission string for implementing Wings8OS Private Api">
      Interface and communicate with openWings8 core services and processes.
    </message>
  </if>
  <message name="IDS_EXTENSION_PROMPT_WARNING_WINGS8OS_SHELL_CLIENT_API" desc="Permission for excuting shell command">
    Read and write files to your hard drive; executing safe and whitelisted commands in the shell.
  </message>

</grit-part>
