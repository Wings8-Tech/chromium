<?xml version="1.0" encoding="utf-8"?>
<grit-part>
  <!-- override chrome/app/resources/locale_settings.grd -->
  <if expr="use_wings8os_com">
    <message name="IDS_FACTORY_RESET_HELP_URL" translateable="false">
      https://wings8.org/?ospath=docs/manual/fix-problems/reset-your-wings8os-device-to-factory-settings/
    </message>
  </if>
  <if expr="not use_wings8os_com">
    <message name="IDS_FACTORY_RESET_HELP_URL" translateable="false">
      https://wings8.org/?ospath=docs/manual/fix-problems/reset-your-wings8os-device-to-factory-settings/
    </message>
  </if>
</grit-part>
