  <!-- === OS Trial subtitle === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_OS_TRIAL_SUBTITLE" desc="Subtitle of the install or try screen, the first screen of the ChromeOS Flex Installation flow">
      <ph name="BEGIN_PARAGRAPH1">&lt;p&gt;</ph><ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> est un systÃ¨me d'exploitation franÃ§ais, souverain et open core, spÃ©cialement conÃ§u pour fonctionner exclusivement sur le dispositif Wings8. Il s'exÃ©cute en natif sur votre appareil, sans nÃ©cessiter d'installation sur disque dur.<ph name="END_PARAGRAPH1">&lt;/p&gt;</ph>
      <ph name="BEGIN_PARAGRAPH2">&lt;p&gt;</ph>Il offre une gestion intelligente de la mÃ©moire virtuelle, ce qui permet d'optimiser les performances mÃªme lorsque la RAM physique est limitÃ©e. De plus, en cas de panne du disque dur, votre appareil Wings8 assure automatiquement la continuitÃ© de service.<ph name="END_PARAGRAPH2">&lt;/p&gt;</ph>
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_OS_TRIAL_SUBTITLE" desc="Subtitle of the install or try screen, the first screen of the ChromeOS Flex Installation flow">
      <ph name="BEGIN_PARAGRAPH1">&lt;p&gt;</ph><ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> is an India sovereign and open-core operating system, specially designed to run exclusively on the Wings8 device. It runs natively on your device, without requiring installation on a hard drive.<ph name="END_PARAGRAPH1">&lt;/p&gt;</ph>
      <ph name="BEGIN_PARAGRAPH2">&lt;p&gt;</ph>It offers intelligent virtual memory management, which optimises performance even when physical RAM is limited. Additionally, in the event of a hard drive failure, your Wings8 device automatically ensures service continuity.<ph name="END_PARAGRAPH2">&lt;/p&gt;</ph>
    </message>
  </if>

