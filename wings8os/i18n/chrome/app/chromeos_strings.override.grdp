  <!-- === Gemini / Wings8OS AI === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_GEMINI_INTRO_TITLE" desc="The title of the gemini intro dialog">
      DÃ©couvrez Wings8OS AI, votre assistant IA au niveau du systÃ¨me
    </message>
    <message name="IDS_GEMINI_INTRO_SUBTITLE" desc="The subtitle of the gemini intro dialog">
      <ph name="BEGIN_PARAGRAPH1">&lt;p&gt;</ph>Lancez une conversation rapide dans Wings8OS AI pour commencer Ã  Ã©crire, planifier, apprendre et bien plus encore en crÃ©ant divers assistants IA. Wings8OS AI est Ã©galement accessible en appuyant sur Ctrl + C + C n'importe oÃ¹ pour des actions rapides personnalisables.<ph name="END_PARAGRAPH1">&lt;/p&gt;</ph>
      <ph name="BEGIN_PARAGRAPH2">&lt;p&gt;</ph>Pour utiliser Wings8OS AI, vous devez vous connecter avec un compte Wings8OS. Si vous n'en avez pas encore, vous pouvez vous inscrire gratuitement.<ph name="END_PARAGRAPH2">&lt;/p&gt;</ph>
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_GEMINI_INTRO_TITLE" desc="The title of the gemini intro dialog">
      Introducing Wings8OS AI, your OS level AI assistant
    </message>
    <message name="IDS_GEMINI_INTRO_SUBTITLE" desc="The subtitle of the gemini intro dialog">
      <ph name="BEGIN_PARAGRAPH1">&lt;p&gt;</ph>Start a quick chat in Wings8OS AI to begin writing, planning, learning, and more by creating various AI assistants. Wings8OS AI is also accessible by pressing Ctrl + C + C anywhere for customisable quick actions.<ph name="END_PARAGRAPH1">&lt;/p&gt;</ph>
      <ph name="BEGIN_PARAGRAPH2">&lt;p&gt;</ph>To use Wings8OS AI, you'll need to sign in with a Wings8OS account. If you don't have one yet, you can sign up for free.<ph name="END_PARAGRAPH2">&lt;/p&gt;</ph>
    </message>
  </if>

  <!-- === ChromeVox (openwings8) === -->
  <if expr="openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_LAPTOP_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in laptop mode." is_accessibility_with_no_ui="true">
        Le lecteur d'Ã©cran openWings8, ChromeVox, est principalement utilisÃ© par les personnes aveugles ou malvoyantes pour lire le texte affichÃ© Ã  l'Ã©cran avec un synthÃ©tiseur vocal ou un afficheur braille. Appuyez sur la barre d'espace pour activer ChromeVox. Une fois ChromeVox activÃ©, vous suivrez une visite guidÃ©e rapide.
      </message>
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_TABLET_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in tablet mode." is_accessibility_with_no_ui="true">
        Le lecteur d'Ã©cran openWings8, ChromeVox, est principalement utilisÃ© par les personnes aveugles ou malvoyantes pour lire le texte affichÃ© Ã  l'Ã©cran avec un synthÃ©tiseur vocal ou un afficheur braille. Maintenez les deux touches de volume enfoncÃ©es pendant cinq secondes pour activer ChromeVox. Une fois ChromeVox activÃ©, vous suivrez une visite guidÃ©e rapide.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_LAPTOP_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in laptop mode." is_accessibility_with_no_ui="true">
        The screen reader on openWings8, ChromeVox, is primarily used by people with blindness or low vision to read text displayed on the screen with a speech synthesizer or braille display. Press the space bar to turn on ChromeVox. When ChromeVox is activated, you'll go through a quick tour.
      </message>
      <message name="IDS_OOBE_CHROMEVOX_HINT_ANNOUNCEMENT_TEXT_TABLET_EXPANDED" desc="The new string spoken when the ChromeVox hint is activated when the device is in tablet mode." is_accessibility_with_no_ui="true">
        The screen reader on openWings8, ChromeVox, is primarily used by people with blindness or low vision to read text displayed on the screen with a speech synthesizer or braille display. Press and hold both volume keys for five seconds to turn on ChromeVox. When ChromeVox is activated, you'll go through a quick tour.
      </message>
    </if>
  </if>

