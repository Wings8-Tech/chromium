<?xml version="1.0" encoding="utf-8"?>
<!-- override chrome/app/chromeos_strings.grdp, included from generated_resources.grd -->
<grit-part>
  <!-- === Welcome / Network / Trial === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_ACCOUNT_MANAGER_DIALOG_ADD_ACCOUNT_LABEL" desc="Label of the Add account button on Account picker screen.">
      Ajouter un compte Wings8
    </message>
    <message name="IDS_NEW_WELCOME_SCREEN_GREETING" desc="Greeting message on the OOBE welcome screen">
      Bienvenue sur <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph>
    </message>
    <message name="IDS_NETWORK_SELECTION_TITLE" desc="Title of network selection screen" meaning="A title of the dialog where user should select network to connect to Internet">
      Connectez-vous pour profiter de toutes les fonctionnalitÃ©s de votre dispositif Wings8
    </message>
    <message name="IDS_OS_TRIAL_TRY_TITLE" desc="Title of the install option in the install or try screen, the first screen of the ChromeOS Flex Installation flow">
      DÃ©marrer sur Wings8OS
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_ACCOUNT_MANAGER_DIALOG_ADD_ACCOUNT_LABEL" desc="Label of the Add account button on Account picker screen.">
      Add Wings8 Account
    </message>
    <message name="IDS_NEW_WELCOME_SCREEN_GREETING" desc="Greeting message on the OOBE welcome screen">
      Welcome to <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph>
    </message>
    <message name="IDS_NETWORK_SELECTION_TITLE" desc="Title of network selection screen" meaning="A title of the dialog where user should select network to connect to Internet">
      Connect to enjoy all the features of your Wings8 device
    </message>
    <message name="IDS_OS_TRIAL_TRY_TITLE" desc="Title of the install option in the install or try screen, the first screen of the ChromeOS Flex Installation flow">
      Boot into Wings8OS
    </message>
  </if>

  <!-- === API Keys notice (openwings8 only) === -->
  <if expr="openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_LOGIN_API_KEYS_NOTICE" desc="Notice displayed on the login screen in case if API keys are missing.">
        Vous ne pourrez pas ajouter d'utilisateurs car les clÃ©s API Google et Wings8OS sont manquantes. Voir <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> pour plus de dÃ©tails.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_LOGIN_API_KEYS_NOTICE" desc="Notice displayed on the login screen in case if API keys are missing.">
        You will not be able to add users because Google API and Wings8OS API keys are missing. See <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for details.
      </message>
    </if>
  </if>

  <!-- === Local State error (powerwash required) === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_LOCAL_STATE_ERROR_TEXT_1" desc="Text for notification that all local files will be deleted while Wings8OS account and any synced data won't be affected.">
      La rÃ©initialisation de votre appareil n'a aucune incidence sur vos comptes Wings8OS ni sur leurs donnÃ©es synchronisÃ©es. Toutefois, tous les fichiers enregistrÃ©s en local sur votre appareil vont Ãªtre supprimÃ©s.
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_LOCAL_STATE_ERROR_TEXT_1" desc="Text for notification that all local files will be deleted while Wings8OS account and any synced data won't be affected.">
      Resetting your device will not affect your Wings8OS accounts or any data synced to these accounts. However, all files saved locally on your device will be deleted.
    </message>
  </if>

  <!-- === Marketing opt-in === -->
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_LOGIN_MARKETING_OPT_IN_SCREEN_SUBTITLE" desc="The sub-title of the dialog that allows user to opt-in into several Google marketing options.">
      Recevez des conseils et mises Ã  jour pour votre <ph name="DEVICE_TYPE">$1<ex>Wings8OS device</ex></ph> de la part de Wings8 Technology
