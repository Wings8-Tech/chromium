    <message name="IDS_WINGS8OS_INSTALLER_APP_NAME" desc="wings8os installer app name">
      Installateur
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_APP_DESC" desc="desc for wings8os installer">
      Cet utilitaire vous aidera à installer <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> sur le stockage interne de cet appareil.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_APP_DISCLAIMER" desc="warning message">
      Attention ! Cette procédure est destructive et irréversible. Nous déclinons toute responsabilité en cas de perte de données ou de support technique urgent ; procédez à vos propres risques.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_FULL_DISK_INSTALLATION_TITLE" desc="title of full disk installation button">
      Installation sur disque complet
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_FULL_DISK_INSTALLATION_HELPER_TEXT" desc="helper text for full disk installation radio">
      Installer <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> sur un disque entier ; toutes les données du disque cible seront effacées.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_INSTALLATION_TITLE" desc="title of dualboot installation button">
      Installation multi-amorçage
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_INSTALLATION_HELPER_TEXT" desc="helper text for dualboot installation radio">
      Installer <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> sur une partition existante d'un disque, en parallèle avec d'autres systèmes. Toutes les données de la partition cible seront effacées.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_FULL_DISK_INSTALLATION_DISCLAIMER" desc="warning message in full disk installation page">
      <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> sera installé sur le disque sélectionné ; toutes les données du disque cible seront effacées.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_TEXT_ON_INSTALL_BUTTON" desc="text on wings8os installer install button">
      Installer
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_CONFIG_DISK_SELECT_LABEL" desc="wings8os installer full disk installation, disk select label">
      Disque
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_NORMAL_CONFIG_NO_AVAILABLE_DISK" desc="error message if no disk available">
      Aucun disque disponible
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALLING_TITLE" desc="title of wings8os installer installing page">
      Installation en cours...
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_TEXT_ON_SHUTDOWN_BUTTON" desc="text on shutdown button of wings8os installer">
      Arrêter
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALL_SUCCESS_TITLE" desc="title for installing success, wings8os installer">
      Installation terminée
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALL_FAILED_TITLE" desc="title for installing failure, wings8os installer">
      Échec de l'installation
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALL_SUCCESS_MESSAGE" desc="message for installing success, wings8os installer">
      L'installation s'est terminée avec succès. Veuillez d'abord éteindre l'appareil, retirer tout support d'installation, puis le redémarrer pour démarrer <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph>.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALL_FAILED_MESSAGE" desc="message for installing failed, wings8os installer">
      Une erreur s'est produite et l'installation n'a pas abouti. Veuillez réessayer. Si l'erreur persiste, contactez le support Wings8OS avec le journal ci-dessus.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_INSTALLATION_DESC" desc="desc message in dualboot installation page">
      <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> sera installé sur la partition sélectionnée. Avec le schéma multi-amorçage actuel, cela n'est possible que si l'appareil prend en charge l'UEFI et que les disques sont au format GPT.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_INSTALLATION_DISCLAIMER" desc="warning message in dualboot installation page">
      La partition cible sera effacée ; vous devez également indiquer votre partition EFI active (généralement détectée automatiquement), l'installateur devant modifier la configuration de démarrage.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_CONFIG_SELECT_OS_PARTITION" desc="title of select os part">
      Sélectionner la partition cible <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph>
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_CONFIG_PARTITION_SELECT_LABEL" desc="os part select label">
      Partition
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_CONFIG_SELECT_EFI_PARTITION" desc="title of select efi part">
      Sélectionner la partition EFI
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_SELECTED_DISK_HAS_NO_AVAIL_OS_PARTITION" desc="selected disk has no available os part">
      Aucune partition disponible pour le disque sélectionné
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_SELECTED_DISK_HAS_NO_AVAIL_EFI_PARTITION" desc="selected disk has no available efi part">
      Aucune partition EFI disponible pour le disque sélectionné
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_SELECTED_PARTITION_SIZE_SMALLER" desc="warning message if small part is selected">
      La partition sélectionnée fait moins de 20 Go, l'installation peut échouer
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_DUALBOOT_SELECTED_PARTITION_ALREADY_INSTALLED" desc="error message if part mounted wings8os_dualboot">
      La partition sélectionnée est déjà utilisée pour le multi-amorçage <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph>, une réinstallation peut échouer
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_MULTI_BOOT_OPTION_TITLE" desc="multi boot option title">
      Comment souhaitez-vous démarrer <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> après l'installation ?
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALL_REFIND_TITLE" desc="refind option title">
      Installer et configurer rEFInd pour moi (recommandé)
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALL_REFIND_HELPER_TEXT" desc="refind helper text">
      rEFInd est un gestionnaire de démarrage qui affiche une interface graphique pour choisir le système au démarrage. Pour plus d'informations, consultez le site de rEFInd.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALL_UEFI_BOOT_TITLE" desc="uefi boot option title">
      Ajouter une entrée au menu de démarrage UEFI
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_INSTALL_UEFI_BOOT_HELPER_TEXT" desc="uefi boot helper text">
      Au démarrage, vous pourrez accéder au menu UEFI (souvent via une touche) ; cette option ajoute <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> à ce menu. (Prise en charge limitée selon le BIOS/UEFI.)
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_MULTI_BOOT_CONFIGURE_BY_YOURSELF_TITLE" desc="multi boot do nothing option title">
      Ne rien faire, je configurerai moi-même
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_MULTI_BOOT_CONFIGURE_BY_YOURSELF_HELPER_TEXT" desc="multi boot option do nothing helper text">
      L'installateur copiera uniquement les fichiers .efi nécessaires au démarrage de <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> sur votre partition EFI ; vous devrez configurer le démarrage vous-même.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_TEXT_ON_ABORT_BUTTON" desc="text on abort button, wings8os installer">
      Quitter de force
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_ABORT_TITLE" desc="title for abort , wings8os installer">
      Quitter de force
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_ABORT_MESSAGE" desc="message for abort, wings8os installer">
      Le processus d'installation a été interrompu
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_GET_DISK_INFO_FAILED" desc="Error message if get disk information failed">
      Échec de l'obtention des informations du disque
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_ABORTING_MESAGE" desc="aborting message for wings8os installer">
      L'installation est en cours d'interruption...
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_USB_INSTALLATION_TITLE" desc="Title for USB installation option, wings8os installer">
      Installer sur USB
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_USB_INSTALLATION_HELPER_TEXT" desc="Helper text for USB installation option, wings8os installer">
      Installez <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> sur un disque USB ; toutes les données du disque USB cible seront effacées.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_USB_INSTALLATION_DISCLAIMER" desc="Disclaimer for USB installation, wings8os installer">
      <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> sera installé sur le disque USB sélectionné ; toutes les données du disque cible seront effacées.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_USB_CONFIG_NO_AVAILABLE_DISK" desc="Message when no USB disk is available, wings8os installer">
      Aucun disque USB disponible
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_CREATE_OS_PART_OPTION" desc="Option that asks the installer to create the Wings8OS target partition">
      Créer une nouvelle partition <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph>
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_CREATE_OS_PART_SIZE_LABEL" desc="Label of the size selector for the partition created for Wings8OS">
      Espace à réserver pour <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph>
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_CREATE_OS_PART_SIZE_HELPER_TEXT" desc="Helper text explaining how the Wings8OS partition is created">
      <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> crée une nouvelle partition dans l'espace libre du disque. Si le disque est plein, la partition Windows est réduite (aucune donnée Windows n'est effacée, mais sauvegardez vos données par précaution).
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_SHRINK_OS_PART_OPTION" desc="Option that asks the installer to shrink the existing Wings8OS partition to install a second Wings8OS alongside">
      Réduire cet appareil pour installer <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> à côté
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_SHRINK_OS_PART_HELPER_TEXT" desc="Helper text explaining that the existing Wings8OS partition will be shrunk">
      Le disque est plein et ne contient pas de partition Windows réductible. <ph name="DEVICE_OS">$1<ex>Wings8OS</ex></ph> réduit sa propre partition existante (aucune donnée n'est effacée, mais sauvegardez vos données par précaution), puis crée la nouvelle partition dans l'espace libéré.
    </message>
    <message name="IDS_WINGS8OS_INSTALLER_CREATE_OS_PART_FAILED" desc="Error message when the Wings8OS partition could not be created">
      Impossible de créer la partition multi-amorçage. Vérifiez l'espace disponible ou réduisez la taille demandée.
    </message>
    <message name="IDS_WINGS8OS_OOBE_WELCOME_DISABLE_NEXT_DESC" desc="oobe welcome disable next desc">
      Nous avons détecté que vous utilisez Wings8OS à partir d'une image téléchargée. Pour bénéficier des mises à jour et du support complets, nous recommandons d'utiliser l'« Installateur » pour une installation sur disque. Vous pouvez <ph name="LINK_BEGIN">&lt;span id="continue-anyway"&gt;</ph>continuer à utiliser cette copie sans installer<ph name="LINK_END">&lt;/span&gt;</ph>, mais après une installation ultérieure toutes les données seront effacées et vous repartirez de cette page.
    </message>
    <message name="IDS_WINGS8OS_OOBE_WELCOME_DISABLE_NEXT_CONTINUE_ANYWAY" desc="oobe welcome disable next, continue anyway">
      Vous pouvez <ph name="LINK_BEGIN">&lt;span id="continue-anyway"&gt;</ph>continuer à utiliser cette copie de Wings8OS sans installer<ph name="LINK_END">&lt;/span&gt;</ph> ; l'installation pourra être effectuée plus tard, mais toutes vos données seront effacées et vous repartirez de cette page.
    </message>
    <message name="IDS_PASSWORD_SELECTION_WINGS8_SUBTITLE" desc="Message displayed on the password selection screen.">
      Au lieu du mot de passe de votre compte Wings8OS, vous pouvez définir un mot de passe <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> pour cet appareil
    </message>
    <message name="IDS_PASSWORD_SELECTION_WINGS8_PASSWORD_LABEL" desc="Label for the online password option on the password selection screen.">
      Utiliser le mot de passe du compte Wings8OS
    </message>
    <message name="IDS_LOGIN_LOCAL_PASSWORD_WINGS8_SETUP_SUBTITLE" desc="Subtitle for the local password setup dialog.">
      Au lieu du mot de passe de votre compte Wings8OS, vous pouvez créer un mot de passe <ph name="DEVICE_TYPE">$1<ex>Chromebook</ex></ph> pour cet appareil
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_WINGS8OS_BACKUP_NOTIFICATION_RUNNING_TITLE" desc="Title of backup notification when backup is running.">
