    <message name="IDS_OOBE_DISPLAY_SIZE_STORE_APP_NAME" desc="Store app name in the preview section of the display size screen.">
      Boutique d'applications
    </message>
    <message name="IDS_OOBE_DISPLAY_SIZE_ONE_DRIVE_APP_NAME" desc="One drive app name in the preview section of the display size screen.">
      OneDrive
