<?xml version="1.0" encoding="utf-8"?>
<grit-part>
  <if expr="openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNUP_TITLE" desc="Title of oobe wings8os local signup page">
        Créer votre compte local openWings8
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_TITLE" desc="Title of oobe wings8os local signin page">
        Connectez-vous à votre compte local openWings8
      </message>
    </if>
    <if expr="lang == 'es'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNUP_TITLE" desc="Title of oobe wings8os local signup page">
        Crea tu cuenta local de openWings8
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_TITLE" desc="Title of oobe wings8os local signin page">
        Inicia sesión en tu cuenta local de openWings8
      </message>
    </if>
    <if expr="lang == 'it'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNUP_TITLE" desc="Title of oobe wings8os local signup page">
        Crea il tuo account locale openWings8
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_TITLE" desc="Title of oobe wings8os local signin page">
        Accedi al tuo account locale openWings8
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA' and lang != 'es' and lang != 'it'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNUP_TITLE" desc="Title of oobe wings8os local signup page">
        Create your local openWings8 account
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_TITLE" desc="Title of oobe wings8os local signin page">
        Sign in your local openWings8 account
      </message>
    </if>
  </if>
  <if expr="not openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNUP_TITLE" desc="Title of oobe wings8os local signup page">
        Créer votre compte local Wings8OS
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_TITLE" desc="Title of oobe wings8os local signin page">
        Connectez-vous à votre compte local Wings8OS
      </message>
    </if>
    <if expr="lang == 'es'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNUP_TITLE" desc="Title of oobe wings8os local signup page">
        Crea tu cuenta local de Wings8OS
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_TITLE" desc="Title of oobe wings8os local signin page">
        Inicia sesión en tu cuenta local de Wings8OS
      </message>
    </if>
    <if expr="lang == 'it'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNUP_TITLE" desc="Title of oobe wings8os local signup page">
        Crea il tuo account locale Wings8OS
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_TITLE" desc="Title of oobe wings8os local signin page">
        Accedi al tuo account locale Wings8OS
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA' and lang != 'es' and lang != 'it'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNUP_TITLE" desc="Title of oobe wings8os local signup page">
        Create your local Wings8OS account
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_TITLE" desc="Title of oobe wings8os local signin page">
        Sign in your local Wings8OS account
      </message>
    </if>
  </if>
  <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_USERNAME" desc="Label of oobe wings8os local signin page, username input">
      Nom d'utilisateur
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_INVALID_USERNAME" desc="Error message of oobe wings8os local signin page, username input">
      Nom d'utilisateur invalide
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD" desc="Label of oobe wings8os local signin page, password input">
      Mot de passe
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_INVALID_PASSWORD" desc="Error message of oobe wings8os local signin page, password input">
      Veuillez saisir un mot de passe
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD_CONFIRM" desc="Label of oobe wings8os local signin page, password_confirm input">
      Confirmer le mot de passe
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD_CONFIRM_ERROR" desc="Error message of oobe wings8os local signin page, password_confirm input">
      Les mots de passe ne correspondent pas
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_NEW_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe wings8os local signin page, password_confirm input">
      Créer un nouveau compte local
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe wings8os local signin page, password_confirm input">
      Se connecter à un compte existant
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_ERROR_MESSAGE" desc="Error message of oobe wings8os local signin page, password_confirm input">
      Le nom d'utilisateur ou le mot de passe est incorrect
    </message>
    </if>
    <if expr="lang == 'es'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_USERNAME" desc="Label of oobe wings8os local signin page, username input">
        Nombre de usuario
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_INVALID_USERNAME" desc="Error message of oobe wings8os local signin page, username input">
        Nombre de usuario no válido
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD" desc="Label of oobe wings8os local signin page, password input">
        Contraseña
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_INVALID_PASSWORD" desc="Error message of oobe wings8os local signin page, password input">
        Introduce una contraseña
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD_CONFIRM" desc="Label of oobe wings8os local signin page, password_confirm input">
        Confirmar contraseña
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD_CONFIRM_ERROR" desc="Error message of oobe wings8os local signin page, password_confirm input">
        Las contraseñas no coinciden
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_NEW_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe wings8os local signin page, password_confirm input">
        Crear una cuenta local nueva
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe wings8os local signin page, password_confirm input">
        Iniciar sesión en una cuenta existente
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_ERROR_MESSAGE" desc="Error message of oobe wings8os local signin page, password_confirm input">
        El nombre de usuario o la contraseña que has introducido son incorrectos
      </message>
    </if>
    <if expr="lang == 'it'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_USERNAME" desc="Label of oobe wings8os local signin page, username input">
        Nome utente
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_INVALID_USERNAME" desc="Error message of oobe wings8os local signin page, username input">
        Nome utente non valido
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD" desc="Label of oobe wings8os local signin page, password input">
        Password
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_INVALID_PASSWORD" desc="Error message of oobe wings8os local signin page, password input">
        Inserisci una password
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD_CONFIRM" desc="Label of oobe wings8os local signin page, password_confirm input">
        Conferma password
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD_CONFIRM_ERROR" desc="Error message of oobe wings8os local signin page, password_confirm input">
        Le password non corrispondono
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_NEW_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe wings8os local signin page, password_confirm input">
        Crea un nuovo account locale
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe wings8os local signin page, password_confirm input">
        Accedi a un account esistente
      </message>
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_ERROR_MESSAGE" desc="Error message of oobe wings8os local signin page, password_confirm input">
        Il nome utente o la password inseriti non sono corretti
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA' and lang != 'es' and lang != 'it'">
      <message name="IDS_WINGS8OS_LOCAL_SIGNIN_USERNAME" desc="Label of oobe wings8os local signin page, username input">
      Username
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_INVALID_USERNAME" desc="Error message of oobe wings8os local signin page, username input">
      Invalid username
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD" desc="Label of oobe wings8os local signin page, password input">
      Password
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_INVALID_PASSWORD" desc="Error message of oobe wings8os local signin page, password input">
      Please input a password
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD_CONFIRM" desc="Label of oobe wings8os local signin page, password_confirm input">
      Confirm password
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_PASSWORD_CONFIRM_ERROR" desc="Error message of oobe wings8os local signin page, password_confirm input">
      Your passwords do not match
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_NEW_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe wings8os local signin page, password_confirm input">
      Create a new local account
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe wings8os local signin page, password_confirm input">
      Sign in to an existing account
    </message>
    <message name="IDS_WINGS8OS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_ERROR_MESSAGE" desc="Error message of oobe wings8os local signin page, password_confirm input">
      The username or password you entered is incorrect
    </message>
    </if>
  <if expr="openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_WINGS8_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use wings8 local account">
        Vous pouvez <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>vous connecter avec un compte local openWings8<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
      </message>
    </if>
    <if expr="lang == 'es'">
      <message name="IDS_WINGS8_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use wings8 local account">
        Puedes <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>iniciar sesión con una cuenta local de openWings8<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
      </message>
    </if>
    <if expr="lang == 'it'">
      <message name="IDS_WINGS8_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use wings8 local account">
        Puoi <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>accedere con un account locale openWings8<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA' and lang != 'es' and lang != 'it'">
      <message name="IDS_WINGS8_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use wings8 local account">
        You can <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>sign in with a openWings8 local account<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
      </message>
    </if>
  </if>
  <if expr="not openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_WINGS8_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use wings8 local account">
        Vous pouvez <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>vous connecter avec un compte local Wings8OS<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
      </message>
    </if>
    <if expr="lang == 'es'">
      <message name="IDS_WINGS8_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use wings8 local account">
        Puedes <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>iniciar sesión con una cuenta local de Wings8OS<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
      </message>
    </if>
    <if expr="lang == 'it'">
      <message name="IDS_WINGS8_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use wings8 local account">
        Puoi <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>accedere con un account locale Wings8OS<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA' and lang != 'es' and lang != 'it'">
      <message name="IDS_WINGS8_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use wings8 local account">
        You can <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>sign in with a Wings8OS local account<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
      </message>
    </if>
  </if>
  <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_WINGS8OS_ADD_USER_DUP_EMAIL_ERROR_MESSAGE" desc="error message when user want to add existed email with different account type (wings8os or google)">
      L'adresse e-mail <ph name="EMAIL_ADDRESS">$1</ph> existe déjà. Veuillez réessayer avec une autre adresse.
    </message>
    <message name="IDS_WINGS8OS_USE_LOCAL_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
      Utiliser un compte local
    </message>
    <message name="IDS_WINGS8OS_USE_ONLINE_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
      Continuer avec le compte en ligne
    </message>
    <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_ACCOUNT_TITLE" desc="title of modal dialog in gaia_signin screen">
      Passer au compte local ?
    </message>
    <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_1" desc="first hint message of modal dialog in gaia_signin screen">
      Si vous choisissez un compte local, des fonctionnalités telles que la synchronisation de vos données et préférences sur plusieurs appareils et la connexion automatique aux applications web avec votre compte Wings8OS ne fonctionneront pas.
    </message>
    </if>
    <if expr="lang == 'es'">
      <message name="IDS_WINGS8OS_ADD_USER_DUP_EMAIL_ERROR_MESSAGE" desc="error message when user want to add existed email with different account type (wings8os or google)">
        El correo electrónico <ph name="EMAIL_ADDRESS">$1</ph> ya existe. Inténtalo con otro correo electrónico.
      </message>
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_ACCOUNT_TITLE" desc="title of modal dialog in gaia_signin screen">
        ¿Cambiar a una cuenta local?
      </message>
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_1" desc="first hint message of modal dialog in gaia_signin screen">
        Si eliges usar una cuenta local, las funciones útiles como la sincronización de tus datos y preferencias en varios dispositivos y el inicio de sesión automático en aplicaciones web con tu cuenta de Wings8OS no funcionarán.
      </message>
      <message name="IDS_WINGS8OS_USE_LOCAL_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
        Utilizar una cuenta local
      </message>
      <message name="IDS_WINGS8OS_USE_ONLINE_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
        Continuar con la cuenta en línea
      </message>
    </if>
    <if expr="lang == 'it'">
      <message name="IDS_WINGS8OS_ADD_USER_DUP_EMAIL_ERROR_MESSAGE" desc="error message when user want to add existed email with different account type (wings8os or google)">
        L'email <ph name="EMAIL_ADDRESS">$1</ph> esiste già. Riprova con un'altra email.
      </message>
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_ACCOUNT_TITLE" desc="title of modal dialog in gaia_signin screen">
        Passare a un account locale?
      </message>
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_1" desc="first hint message of modal dialog in gaia_signin screen">
        Se scegli di utilizzare un account locale, le funzioni utili come la sincronizzazione dei tuoi dati e delle tue preferenze su più dispositivi e l'accesso automatico alle app web con il tuo account Wings8OS non funzioneranno.
      </message>
      <message name="IDS_WINGS8OS_USE_LOCAL_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
        Utilizza un account locale
      </message>
      <message name="IDS_WINGS8OS_USE_ONLINE_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
        Continua con l'account online
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA' and lang != 'es' and lang != 'it'">
      <message name="IDS_WINGS8OS_ADD_USER_DUP_EMAIL_ERROR_MESSAGE" desc="error message when user want to add existed email with different account type (wings8os or google)">
      Email <ph name="EMAIL_ADDRESS">$1</ph> already exists. Please retry with another email.
    </message>
    <message name="IDS_WINGS8OS_USE_LOCAL_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
      Use local account
    </message>
    <message name="IDS_WINGS8OS_USE_ONLINE_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
      Continue to use online account
    </message>
    <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_ACCOUNT_TITLE" desc="title of modal dialog in gaia_signin screen">
      Switch to local account?
    </message>
    <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_1" desc="first hint message of modal dialog in gaia_signin screen">
      If you opt to use a local account, useful features include synchronising your data and preferences across multiple devices and automatically signing in web apps using your Wings8OS account will not work.
    </message>
    </if>
  <if expr="openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
        Nous recommandons d'utiliser un compte en ligne pour profiter pleinement d'openWings8.
      </message>
    </if>
    <if expr="lang == 'es'">
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
        Recomendamos usar una cuenta en línea para aprovechar openWings8 al máximo.
      </message>
    </if>
    <if expr="lang == 'it'">
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
        Consigliamo di utilizzare un account online per sfruttare openWings8 al massimo.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA' and lang != 'es' and lang != 'it'">
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
        We recommend using an online account to utilise openWings8 to its fullest.
      </message>
    </if>
  </if>
  <if expr="not openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
        Nous recommandons d'utiliser un compte en ligne pour profiter pleinement de Wings8OS.
      </message>
    </if>
    <if expr="lang == 'es'">
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
        Recomendamos usar una cuenta en línea para aprovechar Wings8OS al máximo.
      </message>
    </if>
    <if expr="lang == 'it'">
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
        Consigliamo di utilizzare un account online per sfruttare Wings8OS al massimo.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA' and lang != 'es' and lang != 'it'">
      <message name="IDS_WINGS8OS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
        We recommend using an online account to utilise Wings8OS to its fullest.
      </message>
    </if>
  </if>
  <if expr="openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_LOGIN_GOOGLE_API_KEYS_NOTICE" desc="Notice displayed on the login screen in case if API keys are missing.">
        Vous ne pourrez pas ajouter de comptes Google car les clés API Google sont manquantes. Voir <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> pour plus de détails.
      </message>
      <message name="IDS_LOGIN_WINGS8_API_KEYS_NOTICE" desc="Notice displayed on the login screen in case if API keys are missing.">
        Vous ne pourrez pas ajouter de comptes Wings8OS car les clés API Wings8OS sont manquantes. Voir <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> pour plus de détails.
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
      <message name="IDS_LOGIN_GOOGLE_API_KEYS_NOTICE" desc="Notice displayed on the login screen in case if API keys are missing.">
        You will not be able to add Google accounts because Google API keys are missing. See <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for details.
      </message>
      <message name="IDS_LOGIN_WINGS8_API_KEYS_NOTICE" desc="Notice displayed on the login screen in case if API keys are missing.">
        You will not be able to add Wings8OS accounts because Wings8OS API keys are missing. See <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for details.
      </message>
    </if>
  </if>
  <if expr="lang == 'fr' or lang == 'fr-CA'">
    <message name="IDS_OOBE_PRIVACY_SECTION_TITLE" desc="Title of wings8os privacy page">
      Déclaration de confidentialité
    </message>
    <message name="IDS_OOBE_PRIVACY_IFRAME_LABEL" desc="label of wings8os privacy iframe">
      Contenu de la déclaration de confidentialité
    </message>
    <message name="IDS_LOGIN_MARKETING_OPT_IN_SCREEN_GET_WINGS8_UPDATES_SIGN_ME_UP" desc="A lablel next to the checkbox that controls user subscription to marketing updates and useful information about the user's Chrome device.">
      S'inscrire à la newsletter Wings8OS
    </message>
  </if>
  <if expr="lang != 'fr' and lang != 'fr-CA'">
    <message name="IDS_OOBE_PRIVACY_SECTION_TITLE" desc="Title of wings8os privacy page">
      Privacy statement
    </message>
    <message name="IDS_OOBE_PRIVACY_IFRAME_LABEL" desc="label of wings8os privacy iframe">
      Privacy statement contents
    </message>
    <message name="IDS_LOGIN_MARKETING_OPT_IN_SCREEN_GET_WINGS8_UPDATES_SIGN_ME_UP" desc="A lablel next to the checkbox that controls user subscription to marketing updates and useful information about the user's Chrome device.">
      Sign up for the (very infrequent, promised) newsletter for Wings8OS
    </message>
  </if>
  <if expr="openwings8">
    <if expr="lang == 'fr' or lang == 'fr-CA'">
      <message name="IDS_MARKETING_OPT_IN_WINGS8OS_IMPROVEMENT_PLAN" desc="label for wings8os improvement plan in marketing_opt_in page of oobe">
        Rejoindre le programme d'amélioration de l'expérience utilisateur openWings8
      </message>
    </if>
    <if expr="lang != 'fr' and lang != 'fr-CA'">
