<!-- wings8os_menus -->
<translation id="6011650404329072318">Wings8OS × Nutstore</translation>
<translation id="7292499970804736756">Zaregistrujte sa do Nutstore a synchronizujte svoje súbory v cloude v systéme Wings8OS.</translation>
<translation id="8672291834743661083">Zaregistrujte sa do Nutstore</translation>
<translation id="5103639294476249880">Kliknite na tlačidlo „Pridať aplikáciu“ v nastaveniach zabezpečenia</translation>
<translation id="8371020157576651120">Vygenerujte a skopírujte heslo aplikácie</translation>
<translation id="3855250998276979579">Otvorte aplikáciu Nutstore</translation>
<translation id="6565655783894300125">a pripojte účet Nutstore k systému Wings8OS pomocou svojej e-mailovej adresy a hesla aplikácie</translation>
<translation id="4208217820626259628">Wings8Drop</translation>
<translation id="77997252117517973">Už čoskoro</translation>
<translation id="4928968570611226525">Ak chcete pokračovať v tejto akcii, musíte na zariadení Wings8OS <ph name="BEGIN_LINK_ARC_APP" />&gt;aktivovať subsystém Android<ph name="END_LINK_ARC_APP" />; zariadenie Wings8OS musí byť tiež <ph name="BEGIN_LINK_HELP" />prepnuté do režimu vývojára<ph name="END_LINK_HELP" />.</translation>
<translation id="7395250550107972941">Súbory .apk sa nedajú nainštalovať pomocou sideloadingu. Uistite sa, že bol aktivovaný subsystém Android a že ste v režime vývojára Wings8OS.</translation>
<translation id="5690820326685091783">Otvoriť pomocou Wings8OS AI</translation>
</translationbundle>
