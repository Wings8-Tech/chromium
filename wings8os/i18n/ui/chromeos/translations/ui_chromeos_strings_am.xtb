<!-- wings8os_menus -->
<translation id="6011650404329072318">Wings8OS × Nutstore</translation>
<translation id="7292499970804736756">ፋይሎችዎን በWings8OS ውስጥ በደመና ለማመሳሰል Nutstore ይመዝገቡ።</translation>
<translation id="8672291834743661083">Nutstore ይመዝገቡ</translation>
<translation id="5103639294476249880">በደህንነት ቅንብሮች ውስጥ "መተግበሪያ ጨምር" የሚለውን ቁልፍ ይጫኑ</translation>
<translation id="8371020157576651120">የመተግበሪያ የይለፍ ቃልዎን ይፍጠሩ እና ይቅዱ</translation>
<translation id="3855250998276979579">የNutstore መተግበሪያን ይክፈቱ</translation>
<translation id="6565655783894300125">እና Nutstore መለያን ከWings8OS ጋር በኢሜይልዎ እና በመተግበሪያ የይለፍ ቃልዎ ያገናኙ</translation>
<translation id="4208217820626259628">Wings8Drop</translation>
<translation id="77997252117517973">በቅርቡ ይመጣል</translation>
<translation id="4928968570611226525">በዚህ እርምጃ ለመቀጠል በWings8OS መሣሪያዎ ላይ <ph name="BEGIN_LINK_ARC_APP" />&gt;የAndroid ንዑስ ሥርዓትን ማንቃት<ph name="END_LINK_ARC_APP" /> ያስፈልግዎታል፤ እንዲሁም Wings8OS መሣሪያዎ <ph name="BEGIN_LINK_HELP" />ወደ ገንቢ ሁነታ መቀየር<ph name="END_LINK_HELP" /> አለበት።</translation>
<translation id="7395250550107972941">.apk ፋይሎችን መጫን አልተቻለም። እባክዎ የAndroid ንዑስ ሥርዓቱ እንደተነቃ እና በWings8OS ገንቢ ሁነታ ውስጥ እንደሆኑ ያረጋግጡ።</translation>
<translation id="5690820326685091783">በWings8OS AI ክፈት</translation>
</translationbundle>
