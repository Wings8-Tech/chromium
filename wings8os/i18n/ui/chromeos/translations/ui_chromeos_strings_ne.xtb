<!-- wings8os_menus -->
<translation id="6011650404329072318">Wings8OS × Nutstore</translation>
<translation id="7292499970804736756">Wings8OS मा आफ्ना फाइलहरू क्लाउड-सिङ्क गर्न Nutstore मा साइन अप गर्नुहोस्।</translation>
<translation id="8672291834743661083">Nutstore मा साइन अप गर्नुहोस्</translation>
<translation id="5103639294476249880">सुरक्षा सेटिङहरूमा "Add Application" बटनमा क्लिक गर्नुहोस्</translation>
<translation id="8371020157576651120">आफ्नो एप्लिकेसन पासवर्ड सिर्जना गरी कपी गर्नुहोस्</translation>
<translation id="3855250998276979579">Nutstore एप खोल्नुहोस्</translation>
<translation id="6565655783894300125">र आफ्नो इमेल र एप्लिकेसन पासवर्डले Nutstore खाता Wings8OS सँग जडान गर्नुहोस्</translation>
<translation id="4208217820626259628">Wings8Drop</translation>
<translation id="77997252117517973">चाँडै आउँदैछ</translation>
<translation id="4928968570611226525">यो कार्य जारी राख्न तपाईंले आफ्नो Wings8OS उपकरणमा <ph name="BEGIN_LINK_ARC_APP" />&gt;Android सबसिस्टम सक्रिय गर्नुपर्नेछ<ph name="END_LINK_ARC_APP" />; साथै तपाईंको Wings8OS उपकरण <ph name="BEGIN_LINK_HELP" />डेभलपर मोडमा स्विच गरिएको<ph name="END_LINK_HELP" /> हुनुपर्छ।</translation>
<translation id="7395250550107972941">.apk फाइलहरू साइडलोड गर्न असमर्थ। कृपया Android सबसिस्टम सक्रिय गरिएको छ र तपाईं Wings8OS डेभलपर मोडमा हुनुहुन्छ भनी सुनिश्चित गर्नुहोस्।</translation>
<translation id="5690820326685091783">Wings8OS AI ले खोल्नुहोस्</translation>
</translationbundle>
