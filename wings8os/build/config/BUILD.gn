import("//build/buildflag_header.gni")
import("//wings8os/build/config/buildflags.gni")

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "USE_WINGS8OS_COM=$use_wings8os_com",
    "IS_OPENWINGS8=$is_openwings8",
    "WINGS8OS_DEVICE=$wings8os_device",
    "USE_WINGS8OS_LICENSE=$use_wings8os_license",
    "WINGS8OS_DEVICE=$wings8os_device",
  ]
}
